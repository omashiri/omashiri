# Omashiri server package manifest: a positive list, independent of omarchy-base.packages.
# The ISO pacstraps kernel, boot, snapper, and openssh from builder/archinstall.packages;
# this list is everything else the headless install selects. Add a package only with a
# reason, and keep the reason on its line.

# Access and network
# networking
networkmanager
# firewall enabled by install/config/firewall.sh
ufw
# transport a headless box is administered over
rsync
# hostname and friends
inetutils
whois

# Filesystem, boot, and update machinery
# ESP maintenance
dosfstools
# keeps modules available across kernel upgrades
kernel-modules-hook
# paccache, checkupdates
pacman-contrib
# package queries used by omarchy-pkg-*
expac
# AUR updates in omarchy-update-aur-pkgs
yay
# omarchy-update-mise
mise-bin
# mise completion dependency
usage
fakeroot

# Containers (the [D] door)
docker
docker-compose
lazydocker
ufw-docker

# Console toolbox the BBS menu and shell init rely on
bash-completion
bat
btop
eza
fastfetch
fd
fzf
git
gum
jq
# the [L] door
lazyjournal
less
man-db
nvim
ripgrep
starship
tmux
unzip
zoxide
dua-cli
