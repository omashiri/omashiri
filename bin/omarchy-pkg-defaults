#!/bin/bash

# omarchy:summary=Print the default package set for this computer's platform and edition, or for the named platform.
# omarchy:args=[x86|aarch64|aarch64-apple|aarch64-qualcomm|aarch64-n1x|aarch64-gb10]
# omarchy:hidden=true

set -eo pipefail

platform=${1:-}
if [[ -z $platform ]]; then
  platform=$(omarchy-hw-platform)
fi

# Image builders written before the platform names settled pass the old ones.
case $platform in
  apple-silicon) platform=aarch64-apple ;;
  generic-aarch64) platform=aarch64 ;;
  generic) platform=x86 ;;
  qualcomm) platform=aarch64-qualcomm ;;
esac

# The server edition uses its own package list instead of the base list.
# When an edition predicate is unavailable (during ISO boot before /etc is
# populated), default to desktop for backward compatibility.
base_list="base"
if command -v omarchy-edition-server &>/dev/null && omarchy-edition-server; then
  base_list="server"
fi

case $platform in
  x86) lists=("$base_list") ;;
  aarch64) lists=("$base_list" aarch64) ;;
  aarch64-apple | aarch64-qualcomm | aarch64-n1x | aarch64-gb10) lists=("$base_list" aarch64 "$platform") ;;
  *)
    echo "Error: unknown platform '$platform'" >&2
    exit 1
    ;;
esac

# The base list always exists. An architecture or platform with nothing to add
# has no list of its own. The server list is a sibling of base.
files=()
for list in "${lists[@]}"; do
  file="$OMARCHY_PATH/install/omarchy-$list.packages"
  if [[ $list == "base" || $list == "server" || -f $file ]]; then
    files+=("$file")
  fi
done

names() {
  sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$@"
}

# One name per line, first occurrence kept, in list order. An aarch64 platform
# leaves out the base packages that only x86_64 builds.
if [[ $platform == "x86" ]]; then
  names "${files[@]}" | awk '!seen[$0]++'
else
  names "${files[@]}" | awk -v skips=<(names "$OMARCHY_PATH/install/omarchy-x86_64-only.packages") '
    BEGIN { while ((getline name < skips) > 0) skip[name] = 1 }
    !skip[$0] && !seen[$0]++'
fi
