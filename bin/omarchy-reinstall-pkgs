#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages from the stable channel, or on Apple Silicon the edge channel
# omarchy:requires-sudo=true

set -e

# Reinstall all default Omarchy packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$OMARCHY_PATH/install/helpers/pacman.sh"
platform=$(omarchy-hw-platform)
channel=$(omarchy_pacman_default_channel "$platform")
omarchy-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
omarchy-update-pacman -Suu --noconfirm

